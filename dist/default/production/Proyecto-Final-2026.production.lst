   655                           ;Config register CONFIG1 @ 0x2007
   656                           ;	Oscillator Selection bits
   657                           ;	FOSC = XT, XT oscillator: Crystal/resonator on RA6/OSC2/CLKOUT and RA7/OSC1/CLKIN
